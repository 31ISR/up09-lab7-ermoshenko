---
const { post } = Astro.props;
---
<article class="blog-card">
  <img src={post.image} alt={post.title} />
  <div class="card-content">
    <time>{post.date}</time>
    <h3>{post.title}</h3>
    <p>{post.description}</p>
    <div class="tags">
      {post.tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</article>
